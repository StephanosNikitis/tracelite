{
  "name": "@tracelite/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "npm run build -w @tracelite/shared",
    "prebuild": "npm run build -w @tracelite/shared",
    "pretypecheck": "npm run build -w @tracelite/shared",
    "pretest": "npm run build -w @tracelite/shared"
  },
  "dependencies": {
    "@tracelite/shared": "*",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "mongoose": "^8.24.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
