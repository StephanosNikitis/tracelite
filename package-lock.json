{
  "name": "tracelite",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tracelite",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@tracelite/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@tracelite/web",
      "version": "0.0.0"
    },
    "apps/worker": {
      "name": "@tracelite/worker",
      "version": "0.0.0"
    },
    "node_modules/@tracelite/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@tracelite/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@tracelite/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@tracelite/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/shared": {
      "name": "@tracelite/shared",
      "version": "0.0.0"
    }
  }
}
